# Development environment (DJANGO_ENV=dev)
# Copy this file to backend/.env.dev and adjust as needed.
# In dev, DEBUG is on and all hosts/CORS origins are allowed by default.

DJANGO_ENV=dev

# Optional overrides (sane dev defaults are used if omitted):
# DJANGO_SECRET_KEY=dev-insecure-secret-key
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=*
# CORS_ALLOW_ALL_ORIGINS=true

# Database (matches docker-compose defaults)
POSTGRES_DB=flip7
POSTGRES_USER=flip7
POSTGRES_PASSWORD=flip7pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
