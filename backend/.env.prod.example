# Production environment (DJANGO_ENV=prod)
# Copy this file to backend/.env.prod and fill in real values before deploying.
# In prod, DEBUG is off and you MUST set the secret key, allowed hosts, and CORS origins.

DJANGO_ENV=prod

# REQUIRED: generate a strong, unique key, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-strong-random-value

# REQUIRED: comma-separated hostnames/IPs that will serve the app
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# REQUIRED: comma-separated frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Optional security toggles (default to secure values in prod)
# DJANGO_DEBUG=false
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_COOKIES=true
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database — use strong, unique credentials
POSTGRES_DB=flip7
POSTGRES_USER=flip7
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
