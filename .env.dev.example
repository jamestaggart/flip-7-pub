# Development environment. Copy this file to .env.dev and adjust if you like:
#   cp .env.dev.example .env.dev
# Every value has a sane default, so `make dev` works even without editing this.
# The real .env.dev is git-ignored — never commit it.

DJANGO_ENV=dev

# Database (matches the dev compose defaults).
POSTGRES_DB=flip7
POSTGRES_USER=flip7
POSTGRES_PASSWORD=flip7pass

# Where the frontend reaches the backend during local development.
NEXT_PUBLIC_API_URL=http://localhost:8000
