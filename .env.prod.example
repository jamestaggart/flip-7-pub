# Production secrets for docker-compose.prod.yml.
# Copy this file to .env.prod on the server and fill in real values:
#   cp .env.prod.example .env.prod
# `make prod` loads it via --env-file .env.prod.
# The real .env.prod is git-ignored — never commit it.

# Your domain, no scheme and no trailing slash (must have a DNS A record to the VPS).
DOMAIN=example.com

# Django secret key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Postgres credentials — use a strong, random password.
POSTGRES_DB=flip7
POSTGRES_USER=flip7
POSTGRES_PASSWORD=change-me-to-a-strong-password
